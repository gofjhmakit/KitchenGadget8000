CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=360
# Correct PSRAM config key for ESP32-P4 (SPIRAM_SUPPORT is not recognized; SPIRAM is)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# UART0 primary console → output goes to the CH340 USB-UART bridge (default 115200)
# Secondary USB-SERIAL-JTAG for when a terminal is connected over USB-OTG
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_MEM_SIZE_KILOBYTES=128
CONFIG_LV_USE_FREERTOS=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y
# JPEG decoding for recipe images (TJpgDec — lightweight, zero external deps)
CONFIG_LV_USE_TJPGD=y
# Flash size: partitions.csv requires 16 MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
# Disable hardware SHA to avoid hal/sha_types.h include-path issue
CONFIG_MBEDTLS_HARDWARE_SHA=n
# LVGL Montserrat font sizes used by Theme.cpp
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# Disable unused LVGL demo/example code to keep ESP32-P4 image size in range
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
# Enable WiFi (via ESP32-C6 wireless host co-processor)
CONFIG_ESP_HOST_WIFI_ENABLED=y
CONFIG_ESP_EFUSE_BLOCK_REV_MIN_FULL=0
CONFIG_ESP_EFUSE_BLOCK_REV_MAX_FULL=199
