CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=360
# Correct PSRAM config key for ESP32-P4 (SPIRAM_SUPPORT is not recognized; SPIRAM is)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# UART0 primary console → output goes to the CH340 USB-UART bridge (default 115200)
# Secondary USB-SERIAL-JTAG for when a terminal is connected over USB-OTG
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_MEM_SIZE_KILOBYTES=128
CONFIG_LV_USE_FREERTOS=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y
# JPEG decoding for recipe images (TJpgDec — lightweight, zero external deps)
CONFIG_LV_USE_TJPGD=y
# Flash size: partitions.csv requires 16 MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
# Disable hardware SHA to avoid hal/sha_types.h include-path issue
CONFIG_MBEDTLS_HARDWARE_SHA=n
# LVGL Montserrat font sizes used by Theme.cpp
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# Disable unused LVGL demo/example code to keep ESP32-P4 image size in range
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
CONFIG_ESP_EFUSE_BLOCK_REV_MIN_FULL=0
CONFIG_ESP_EFUSE_BLOCK_REV_MAX_FULL=199

# ── WiFi via ESP32-C6 co-processor (SDIO transport) ──────────────────────────
# CrowPanel Advanced 9" ESP32-P4 V1.1 — matches Elecrow's official V1.1 example
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
# 1-bit SDIO bus (V1.1 firmware supports 4-bit but 1-bit is stable & official)
CONFIG_ESP_HOSTED_SDIO_1_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=1
# SDIO pin assignments (P4-side GPIOs, per Elecrow V1.1 official sdkconfig)
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=14
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_1BIT_BUS_SLOT_1=15
# C6 reset line (active-high)
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=32
# Give C6 time to boot its SDIO slave after reset before P4 tries to connect
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y
CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS=1500
